---
import "@fontsource-variable/outfit";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  faqs?: { q: string; a: string }[];
}

const { title, description, canonical, faqs = [] } = Astro.props;
const site = "https://www.durin-genshin.com";
const ogImage = `${site}/og.png`;

const publisherSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Durin Genshin Guide",
  url: site,
  logo: `${site}/favicon.png`,
};

const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Genshin Impact",
  url: "https://genshin.hoyoverse.com/",
  gamePlatform: ["Windows", "PlayStation 4", "PlayStation 5", "iOS", "Android"],
  applicationCategory: "Game",
  publisher: {
    "@type": "Organization",
    name: "HoYoverse",
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "en",
  datePublished: "2025-12-03",
  dateModified: "2026-08-25",
  isPartOf: {
    "@type": "WebSite",
    name: "Durin Genshin Guide",
    url: site,
  },
  about: {
    "@type": "VideoGame",
    name: "Genshin Impact",
  },
  author: {
    "@type": "Organization",
    name: "Durin Genshin Guide Editorial Team",
    url: site,
  },
  publisher: {
    "@type": "Organization",
    name: "Durin Genshin Guide",
    url: site,
  },
};

const faqSchema =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: f.a,
          },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Durin Genshin Guide Editorial Team" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Durin Genshin Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(videoGameSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(publisherSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body class="min-h-[100dvh] bg-stone-950 text-stone-200 antialiased">
    <header class="sticky top-0 z-50 border-b border-stone-800/70 bg-stone-950/85 backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="#top" class="flex items-center gap-2" aria-label="Durin Genshin Guide home">
          <span class="h-2.5 w-2.5 rounded-full bg-ember-500" aria-hidden="true"></span>
          <span class="text-base font-bold tracking-tight text-stone-50">Durin Guide</span>
        </a>
        <div class="flex items-center gap-4 text-sm text-stone-400 sm:gap-6">
          <a href="#build" class="transition-colors hover:text-ember-400">Build</a>
          <a href="#lore" class="transition-colors hover:text-ember-400">Lore</a>
          <a href="#materials" class="hidden transition-colors hover:text-ember-400 sm:inline">
            Materials
          </a>
          <a href="#faq" class="transition-colors hover:text-ember-400">FAQ</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="border-t border-stone-800/70 py-10">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
          <div class="max-w-md">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-ember-500" aria-hidden="true"></span>
              <span class="text-sm font-bold text-stone-50">Durin Genshin Guide</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-stone-400">
              A fan-made reference covering Durin's build, lore, and materials. Not affiliated
              with or endorsed by HoYoverse or miHoYo. All game assets and trademarks belong to
              their respective owners.
            </p>
          </div>
          <div class="text-sm text-stone-500">
            <p>&copy; 2025 Durin Genshin Guide. All rights reserved.</p>
            <p class="mt-2">
              <a href="mailto:contact@durin-genshin.com" class="transition-colors hover:text-ember-400">
                contact@durin-genshin.com
              </a>
            </p>
            <p class="mt-1 text-xs leading-relaxed text-stone-600">
              This site uses no cookies and collects no personal data.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
