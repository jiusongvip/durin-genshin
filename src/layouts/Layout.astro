---
import "@fontsource/cinzel/600.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/cinzel/800.css";
import "@fontsource-variable/sora";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  faqs?: { q: string; a: string }[];
  noindex?: boolean;
}

const { title, description, canonical, faqs = [], noindex = false } = Astro.props;
const site = "https://www.durin-genshin.com";
const ogImage = `${site}/og.png`;

const publisherSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Durin Genshin Guide",
  url: site,
  logo: `${site}/favicon.png`,
  description:
    "Independent fan guide to Durin in Genshin Impact: build, lore, materials, constellations and pull value.",
};

const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Genshin Impact",
  url: "https://genshin.hoyoverse.com/",
  gamePlatform: ["Windows", "PlayStation 4", "PlayStation 5", "iOS", "Android"],
  applicationCategory: "Game",
  publisher: {
    "@type": "Organization",
    name: "HoYoverse",
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "en",
  datePublished: "2025-12-03",
  dateModified: "2026-08-26",
  isPartOf: {
    "@type": "WebSite",
    name: "Durin Genshin Guide",
    url: site,
  },
  about: {
    "@type": "VideoGame",
    name: "Genshin Impact",
  },
  author: {
    "@type": "Organization",
    name: "Durin Genshin Guide Editorial Team",
    url: site,
  },
  publisher: {
    "@type": "Organization",
    name: "Durin Genshin Guide",
    url: site,
  },
};

const faqSchema =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: f.a,
          },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Durin Genshin Guide Editorial Team" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Durin Genshin Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(videoGameSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(publisherSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body>
    <div class="loading-veil" id="loading-veil" aria-hidden="true">
      <div>
        <div class="loading-mark mx-auto">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
            <path d="M12 2C8 6 5 9 5 14a7 7 0 0 0 14 0c0-5-3-8-7-12z" />
          </svg>
        </div>
        <p class="loading-word">Durin Guide</p>
      </div>
    </div>

    <div
      id="reading-progress"
      style="position: fixed; top: 0; left: 0; height: 2px; background: #cf7749; z-index: 9999; width: 0%; transition: width 0.1s linear"
      aria-hidden="true"
    ></div>
    <button
      id="back-to-top"
      style="position: fixed; bottom: 24px; right: 24px; width: 52px; height: 52px; border-radius: 50%; background: rgba(23, 21, 18, 0.92); border: 1px solid #3c3933; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4); cursor: pointer; z-index: 9998; display: none; align-items: center; justify-content: center; transition: all 0.3s ease"
      aria-label="Back to top"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#cf7749" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15" />
      </svg>
    </button>

    <Nav />

    <slot />

    <Footer />
  </body>
</html>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var veil = document.getElementById("loading-veil");
    if (veil) {
      var dismiss = function () { veil.classList.add("done"); };
      if (reduce) { dismiss(); }
      else {
        setTimeout(dismiss, 900);
        window.addEventListener("load", function () { setTimeout(dismiss, 400); });
      }
    }

    var bar = document.getElementById("reading-progress");
    var btn = document.getElementById("back-to-top");
    var onScroll = function () {
      var h = document.documentElement;
      var pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      if (bar) bar.style.width = Math.min(pct, 100) + "%";
      if (btn) btn.style.display = window.scrollY > 600 ? "flex" : "none";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    if (btn) {
      btn.addEventListener("click", function () { window.scrollTo({ top: 0, behavior: "smooth" }); });
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) entry.target.classList.add("reveal-in");
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll(".reveal").forEach(function (el) { observer.observe(el); });

    var nav = document.getElementById("main-nav");
    if (nav) {
      var onNavScroll = function () { nav.classList.toggle("nav-solid", window.scrollY > 80); };
      onNavScroll();
      window.addEventListener("scroll", onNavScroll, { passive: true });
    }

    var menuBtn = document.getElementById("mobile-menu-btn");
    var mobileMenu = document.getElementById("mobile-menu");
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener("click", function () {
        var hidden = mobileMenu.classList.toggle("hidden");
        menuBtn.setAttribute("aria-expanded", hidden ? "false" : "true");
      });
      mobileMenu.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () { mobileMenu.classList.add("hidden"); });
      });
    }

    var toc = document.getElementById("page-toc");
    if (toc) {
      var tocLinks = Array.prototype.slice.call(toc.querySelectorAll("a"));
      var map = tocLinks.map(function (a) {
        return document.getElementById(a.getAttribute("href").slice(1));
      });
      var spy = function () {
        var current = null;
        var probe = window.scrollY + window.innerHeight * 0.35;
        map.forEach(function (sec, i) {
          if (sec && sec.offsetTop <= probe) current = tocLinks[i];
        });
        tocLinks.forEach(function (a) { a.classList.remove("is-active"); });
        if (current) current.classList.add("is-active");
      };
      window.addEventListener("scroll", spy, { passive: true });
      spy();
    }
  })();
</script>
