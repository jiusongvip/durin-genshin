---
// Competitor comparison: Durin is a two-form Pyro support/carry, not a direct Xiangling or
// Bennett replacement. Qualitative ratings plus community-tested max-investment uplift figures.
const dims = [
  { d: "Role", durin: "Two-form Pyro support / carry", xiangling: "Off-field Pyro DPS", bennett: "ATK buffer + healer" },
  { d: "Off-field Pyro", durin: "Strong", xiangling: "Strong", bennett: "Weak (skill only)" },
  { d: "RES shred", durin: "Yes (White Flame)", xiangling: "No", bennett: "No" },
  { d: "Vaporize/Melt self-buff", durin: "Yes, +40% (Dark Decay)", xiangling: "No", bennett: "No" },
  { d: "Team ATK buff", durin: "Some (C1)", xiangling: "No", bennett: "Yes, large" },
  { d: "Healing", durin: "No", xiangling: "No", bennett: "Yes" },
  { d: "Key constellation", durin: "C2", xiangling: "C4", bennett: "C1" },
];

const uplift = [
  { char: "Venti", gain: "+67.1%" },
  { char: "Ganyu", gain: "+52.7%" },
  { char: "Clorinde", gain: "+48.1%" },
  { char: "Xiao", gain: "+38%" },
  { char: "Kinich", gain: "+26.7%" },
  { char: "Varesa", gain: "+10.7%" },
];
---

<section id="compare" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Durin vs Xiangling vs Bennett
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-400">
      All three cover off-field Pyro, but they are not direct replacements. Use this table to
      see where Durin sits between the two staples.
    </p>

    <img
      src="/official/anecdote-key.webp"
      alt="Official Genshin Impact key art from Durin's character anecdote, featuring his in-game design"
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
      class="mt-8 w-full rounded-2xl border border-stone-800"
    />

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[36rem] border-collapse text-sm">
        <thead>
          <tr class="text-left">
            <th class="py-3 pr-4 font-medium text-stone-500">Dimension</th>
            <th class="px-4 py-3 font-semibold text-ember-400">Durin</th>
            <th class="px-4 py-3 font-semibold text-stone-200">Xiangling</th>
            <th class="px-4 py-3 font-semibold text-stone-200">Bennett</th>
          </tr>
        </thead>
        <tbody>
          {dims.map((row, i) => (
            <tr class={i === dims.length - 1 ? "" : "border-b border-stone-800/70"}>
              <td class="py-4 pr-4 text-stone-400">{row.d}</td>
              <td class="px-4 py-4 text-stone-100">{row.durin}</td>
              <td class="px-4 py-4 text-stone-300">{row.xiangling}</td>
              <td class="px-4 py-4 text-stone-300">{row.bennett}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
      <p class="text-sm leading-relaxed text-stone-300">
        <span class="font-semibold text-stone-100">Bottom line:</span> Durin is not a direct
        replacement for either. Xiangling deals the off-field Pyro damage, Bennett heals and
        buffs ATK, and Durin is a two-form unit: his White Flame form shreds RES for Electro,
        Dendro, Anemo, and Geo carries, while his Dark Decay form raises his own Vaporize and
        Melt DMG by 40%. His niche is enabling reaction carries rather than out-damaging
        Xiangling or out-buffing Bennett.
      </p>
    </div>

    <div class="mt-10">
      <h3 class="text-xl font-bold tracking-tight text-stone-50">
        Team Damage Uplift at Max Investment
      </h3>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-400">
        Community testing at C6 shows how much Durin's White Flame form raises total team damage
        for each carry. These numbers explain why his RES shred shines most alongside Anemo,
        Electro, and Cryo carries — while his Dark Decay form instead buffs his own Vaporize
        and Melt damage.
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {uplift.map((u) => (
          <div class="rounded-xl border border-stone-800 bg-stone-900/30 p-4">
            <p class="text-sm text-stone-300">{u.char}</p>
            <p class="mt-1 font-mono text-lg font-semibold text-ember-400">{u.gain}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
