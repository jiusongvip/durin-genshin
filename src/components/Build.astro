  { name: "Varka", note: "Hexerei partner who satisfies both buffs; Durin also enables Varka's Pyro infusion." },
  { name: "Lohen", note: "Durin's off-field damage feeds Lohen's Will to Win; both amplify each other's Melt damage." },
  { name: "Mona", note: "Unlocks Dark Form's ceiling with Vaporize buffs and extended Omen duration." },
  { name: "Nicole", note: "General Hexerei partner for team-wide buffs." },
  { name: "Klee", note: "Pyro Resonance plus Hexerei buffs — a core for Vaporize, Melt, or Overload teams." },
