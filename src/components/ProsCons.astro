---
// Pros & Cons plus how to play (rotation). All content in the initial HTML.
const pros = [
  {
    t: "Two buildable forms",
    b: "White Flame shreds Pyro and reaction-element RES; Dark Decay raises his own Vaporize and Melt DMG by 40%. Build him as support or reaction carry.",
  },
  {
    t: "Rare resistance shred",
    b: "White Flame is one of the few ways to shred Anemo RES, which is why Anemo carries gain so much.",
  },
  {
    t: "Low-maintenance off-field Pyro",
    b: "Applies Pyro without field time, sustaining Overload, Burning, Swirl, and Crystallize while your carry stays on field.",
  },
  {
    t: "Broad team fit",
    b: "Slots into Overload, Burning, Anemo, and Geo teams via White Flame, plus Vaporize and Melt via Dark Decay.",
  },
  {
    t: "C0-friendly",
    b: "Fully functional at C0 in both forms, with C1 as a big value spike that buffs his support and carry sides at once.",
  },
];

const cons = [
  {
    t: "Stance management",
    b: "You must know which form you are in — the wrong form for your team kills his value. Not plug-and-play.",
  },
  {
    t: "White Flame shred skips Hydro and Cryo",
    b: "In that form his value in Vaporize and Melt is limited; switch to Dark Decay for those reactions.",
  },
  {
    t: "Not a top-tier hypercarry",
    b: "Dark Decay is a capable reaction carry, but his personal damage ceiling sits below dedicated 5-star DPS units.",
  },
  {
    t: "Hexerei-dependent for full value",
    b: "Part of his damage and RES shred is locked behind Hexerei team buffs; he works outside them but pairs best with another Hexerei member.",
  },
  {
    t: "Frontloaded damage",
    b: "Most of his damage is delegated to the Elemental Burst, making him reliant on Burst procs.",
  },
];

const rotations = [
  {
    name: "White Flame support rotation",
    steps: [
      "Skill → press Skill again to enter Confirmation of Purity.",
      "Burst to summon the Dragon of White Flame and start the RES shred.",
      "Swap to your Electro, Dendro, Anemo, or Geo carry and trigger reactions to keep the shred up.",
    ],
  },
  {
    name: "Dark Decay carry rotation",
    steps: [
      "Skill → Normal Attacks to enter Denial of Darkness.",
      "Burst to summon the Dragon of Dark Decay and gain the +40% Vaporize/Melt bonus.",
      "Apply Hydro or Cryo from teammates and let Durin's hits Vaporize or Melt for amplified damage.",
    ],
  },
];
---

<section id="howto" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Durin Pros, Cons &amp; How to Play
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-400">
      A quick read on where Durin excels, where he falls short, and how to run him in a rotation.
    </p>

    <img
      src="/official/durin-game.webp"
      alt="Official in-game portrait of Durin in Genshin Impact"
      width="700"
      height="1242"
      loading="lazy"
      decoding="async"
      class="mt-8 w-full rounded-2xl border border-stone-800"
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-ember-700/40 bg-ember-950/20 p-6">
        <h3 class="text-base font-semibold text-ember-400">Pros</h3>
        <ul class="mt-4 space-y-4">
          {pros.map((p) => (
            <li>
              <p class="font-medium text-stone-100">{p.t}</p>
              <p class="mt-1 text-sm leading-relaxed text-stone-400">{p.b}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
        <h3 class="text-base font-semibold text-stone-400">Cons</h3>
        <ul class="mt-4 space-y-4">
          {cons.map((c) => (
            <li>
              <p class="font-medium text-stone-100">{c.t}</p>
              <p class="mt-1 text-sm leading-relaxed text-stone-400">{c.b}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <h3 class="mt-14 text-xl font-bold tracking-tight text-stone-50">How to Play (Rotation)</h3>
    <div class="mt-5 grid gap-6 md:grid-cols-2">
      {rotations.map((r) => (
        <div class="rounded-xl border border-stone-800 bg-stone-900/30 p-6">
          <p class="font-semibold text-stone-100">{r.name}</p>
          <ol class="mt-4 space-y-3">
            {r.steps.map((s, i) => (
              <li class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ember-700/50 font-mono text-xs text-ember-400">
                  {i + 1}
                </span>
                <span class="text-sm leading-relaxed text-stone-400">{s}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
