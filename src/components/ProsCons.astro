---
// Pros & Cons plus how to play (rotation). All content in the initial HTML.
const pros = [
  {
    t: "Two buildable forms",
    b: "His White Flame form shreds Pyro and reaction-element RES, while his Dark Decay form raises his own Vaporize and Melt DMG by 40%. You can build him as a support or a reaction carry.",
  },
  {
    t: "Rare resistance shred",
    b: "White Flame lowers enemy Pyro and reaction-element RES, and it is one of the few ways to shred Anemo resistance, which is why Anemo carries gain so much.",
  },
  {
    t: "Low-maintenance off-field Pyro",
    b: "Applies Pyro without needing field time, sustaining Overload, Burning, Swirl, and Crystallize reactions while your carry stays on field.",
  },
  {
    t: "Broad team fit",
    b: "Slots into Overload, Burning, Anemo, and Geo teams through White Flame, and Vaporize and Melt teams through Dark Decay, opening up comps that few other supports enable.",
  },
  {
    t: "C0-friendly",
    b: "Fully functional at C0 in both forms. You do not need constellations to get his core value.",
  },
  {
    t: "C1 is a huge value spike",
    b: "His C1 grants Cycle of Enlightenment stacks that buff both his support and carry sides at once, making it his best-value constellation.",
  },
];

const cons = [
  {
    t: "Stance management",
    b: "His two forms require you to know which state you are in. Picking the wrong form for your team reduces his value, so he is not a plug-and-play pick.",
  },
  {
    t: "White Flame shred skips Hydro and Cryo",
    b: "His White Flame resistance shred excludes Hydro and Cryo, so in that form his value in Vaporize and Melt is limited. Switch to Dark Decay for those reactions instead.",
  },
  {
    t: "Not a top-tier hypercarry",
    b: "His Dark Decay form is a capable Vaporize and Melt carry, but his personal damage ceiling sits below dedicated 5-star DPS characters.",
  },
  {
    t: "Hexerei-dependent for full value",
    b: "A good chunk of his damage and RES shred is locked behind Hexerei team buffs. He still works outside them, but is strongly incentivized to run with another Hexerei member.",
  },
  {
    t: "Frontloaded damage",
    b: "His kit delegates most of his damage to his Elemental Burst, making him reliant on Burst procs to contribute damage in a fight.",
  },
];

const rotations = [
  {
    name: "White Flame support rotation",
    steps: [
      "Cast his Elemental Skill to gain Essential Transmutation, then press Skill again to enter the Confirmation of Purity state.",
      "Cast his Elemental Burst to summon the Dragon of White Flame and start the RES shred.",
      "Swap to your Electro, Dendro, Anemo, or Geo carry and trigger reactions to keep the shred debuff active.",
    ],
  },
  {
    name: "Dark Decay carry rotation",
    steps: [
      "Cast his Elemental Skill to gain Essential Transmutation, then use Normal Attacks to enter the Denial of Darkness state.",
      "Cast his Elemental Burst to summon the Dragon of Dark Decay and gain the +40% Vaporize and Melt bonus.",
      "Apply Hydro or Cryo from your teammates and let Durin's hits Vaporize or Melt for amplified damage.",
    ],
  },
];
---

<section id="howto" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Durin Pros, Cons &amp; How to Play
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-400">
      A quick read on where Durin excels, where he falls short, and how to run him in a rotation.
    </p>

    <img
      src="/official/durin-game.webp"
      alt="Official in-game portrait of Durin in Genshin Impact"
      width="700"
      height="1242"
      loading="lazy"
      decoding="async"
      class="mt-8 w-full rounded-2xl border border-stone-800"
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-ember-700/40 bg-ember-950/20 p-6">
        <h3 class="text-base font-semibold text-ember-400">Pros</h3>
        <ul class="mt-4 space-y-4">
          {pros.map((p) => (
            <li>
              <p class="font-medium text-stone-100">{p.t}</p>
              <p class="mt-1 text-sm leading-relaxed text-stone-400">{p.b}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
        <h3 class="text-base font-semibold text-stone-400">Cons</h3>
        <ul class="mt-4 space-y-4">
          {cons.map((c) => (
            <li>
              <p class="font-medium text-stone-100">{c.t}</p>
              <p class="mt-1 text-sm leading-relaxed text-stone-400">{c.b}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <h3 class="mt-14 text-xl font-bold tracking-tight text-stone-50">How to Play (Rotation)</h3>
    <div class="mt-5 grid gap-6 md:grid-cols-2">
      {rotations.map((r) => (
        <div class="rounded-xl border border-stone-800 bg-stone-900/30 p-6">
          <p class="font-semibold text-stone-100">{r.name}</p>
          <ol class="mt-4 space-y-3">
            {r.steps.map((s, i) => (
              <li class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ember-700/50 font-mono text-xs text-ember-400">
                  {i + 1}
                </span>
                <span class="text-sm leading-relaxed text-stone-400">{s}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
