---
import Layout from "../layouts/Layout.astro";

const title = "Terms of Use — Durin Genshin Guide (Fan-Made Reference)";
const description =
  "Terms of use for Durin Genshin Guide: fan-made content disclaimer, no affiliation with HoYoverse, accuracy notice, and acceptable use of our build and lore data.";
const canonical = "https://www.durin-genshin.com/terms/";
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 pb-24 pt-32 sm:px-6">
    <p class="overline">Terms</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Terms of use</h1>
    <div class="mt-8 space-y-5 text-base leading-relaxed text-stone-300">
      <p>
        <span class="font-semibold text-stone-100">Short version:</span> this is a free,
        fan-made reference. Use it as guidance, not gospel — game numbers can change with any
        version, and the game itself belongs to HoYoverse.
      </p>
      <h2 class="mt-10 text-2xl">Fan-made disclaimer</h2>
      <p>
        Durin Genshin Guide is an independent, unofficial fan project. It is not affiliated
        with, endorsed by, or sponsored by HoYoverse or COGNOSPHERE. Genshin Impact, its
        characters, names, art, and trademarks are the property of their respective owners.
        Official assets referenced on this site remain the property of HoYoverse.
      </p>
      <h2 class="mt-10 text-2xl">Accuracy of content</h2>
      <p>
        We verify build data, materials, and lore against official sources and community
        theorycrafting at the time of writing, and we update the guide for every version. Game
        balance changes frequently, so numbers may lag behind the latest patch. Content is
        provided for informational purposes "as is" without warranty of accuracy or fitness for
        a particular purpose.
      </p>
      <h2 class="mt-10 text-2xl">Acceptable use</h2>
      <p>
        You may read, quote, and link to this site freely — a credit link back to
        <a href="https://www.durin-genshin.com" class="text-ember-300 underline decoration-stone-700 underline-offset-4">durin-genshin.com</a>
        is appreciated. You may not scrape the site in bulk, republish substantial portions as
        your own, or use it to train commercial datasets without permission.
      </p>
      <h2 class="mt-10 text-2xl">Liability</h2>
      <p>
        We are not liable for decisions made based on this guide, including in-game spending.
        Pull decisions are yours: read the
        <a href="/" class="text-ember-300 underline decoration-stone-700 underline-offset-4">pull-value analysis</a>
        and decide with your own primogem budget in mind.
      </p>
      <h2 class="mt-10 text-2xl">Changes</h2>
      <p>
        If these terms ever change, the update date below will be revised. Last updated: August
        26, 2026.
      </p>
    </div>
  </main>
</Layout>
