---
import Layout from "../layouts/Layout.astro";
import PageTOC from "../components/PageTOC.astro";
import Hero from "../components/Hero.astro";
import QuickSummary from "../components/QuickSummary.astro";
import PullDecider from "../components/PullDecider.astro";
import PrimogemCalculator from "../components/PrimogemCalculator.astro";
import Build from "../components/Build.astro";
import Compare from "../components/Compare.astro";
import ProsCons from "../components/ProsCons.astro";
import Lore from "../components/Lore.astro";
import Materials from "../components/Materials.astro";
import FAQ from "../components/FAQ.astro";
import Author from "../components/Author.astro";

const title = "Durin Genshin Impact: Best Build, Lore & Release Date Guide";
const description =
  "Durin in Genshin Impact: Pyro build, best weapons, artifacts, teams, full lore from Dragonspine dragon to playable character, 6.2 release date.";
const canonical = "https://www.durin-genshin.com";

const faqs = [
  {
    q: "Who is Durin in Genshin Impact?",
    a: "A 5-star Pyro sword released in Version 6.2 — a shadow dragon made by Rhinedottir, reborn as Mini Durin in Simulanka, then a playable human in Mondstadt.",
  },
  {
    q: "Is Durin a dragon or a human?",
    a: "Both: the original was a dragon, Mini Durin a fairy-tale dragon, and the playable Durin a human — Albedo merged Mini Durin with the original's remains.",
  },
  {
    q: "When is Durin's release date?",
    a: "Version 6.2 (Luna III), December 3, 2025, Phase 1 of the character banner.",
  },
  {
    q: "Is Durin worth pulling?",
    a: "Depends on your roster: worth it if you lack an off-field Pyro unit or want a Vaporize/Melt carry; a sidegrade if Bennett and Xiangling are built.",
  },
  {
    q: "What is the community consensus on Durin?",
    a: 'On <a href="https://www.reddit.com/r/DurinMains/" target="_blank" rel="noopener">r/DurinMains</a> and creator channels (Zy0x, Doro44): a flexible universal support whose White Flame form is one of the few ways to shred Anemo, Dendro, and Geo RES. Caveats: C0 is not account-defining, and his best teams often want another Hexerei member.',
  },
  {
    q: "How is Durin related to Albedo?",
    a: "Brothers — both created by the alchemist Rhinedottir. Albedo gave Durin his human body by transmuting the original dragon's remains.",
  },
  {
    q: "Who created Durin?",
    a: "The original dragon by Rhinedottir (Gold); Mini Durin by the Hexenzirkel witch Andersdotter.",
  },
  {
    q: "What is Mini Durin?",
    a: "A fairy-tale dragon from Simulanka (Version 4.8), freed from his curse and later merged into the playable Durin.",
  },
  {
    q: "How good are Durin's constellations?",
    a: "C1 is the best value: Cycle of Enlightenment stacks buff both his support and carry sides. C2 adds a team-wide 50% Pyro DMG bonus, C4 raises burst damage 40%, C6 is the capstone.",
  },
  {
    q: "Is Durin good at C0?",
    a: "Yes — fully functional in both forms. Constellations add team value but are not required.",
  },
  {
    q: "How much Energy Recharge does Durin need?",
    a: "Very little: 0% with a crowned Skill and two casts per rotation, otherwise about 100–150%.",
  },
  {
    q: "What is Durin's signature weapon?",
    a: "Athame Artis — high base ATK and Crit Rate, burst Crit DMG boost, and an ATK buff on burst hits.",
  },
  {
    q: "Does Durin need his signature weapon?",
    a: "No. Primordial Jade Cutter and Mistsplitter Reforged are strong alternatives; Wolf-Fang is a great 4-star option.",
  },
  {
    q: "C1 or his signature weapon (R1) — which first?",
    a: 'If you already own a 5-star CRIT sword, C1 is generally better: <a href="https://keqingmains.com/durin-quickguide/" target="_blank" rel="noopener">KQM testing</a> shows it raises team DPS more than an R1 Athame Artis and buffs both his forms at once.',
  },
  {
    q: "What is Durin's best F2P build?",
    a: "Sacrificial Sword or Favonius Sword, with 2pc ATK + 2pc ATK or ATK + Pyro DMG artifacts. Focus on ATK, Crit, and Energy Recharge.",
  },
  {
    q: "What teams does Durin NOT work well in?",
    a: "White Flame's RES shred excludes Hydro and Cryo — switch to Dark Decay for Vaporize and Melt. Physical teams are his weakest fit.",
  },
  {
    q: "What is Durin's special dish?",
    a: "Cook Apple Stew (Trial Version), available in the cooking menu once you own him.",
  },
  {
    q: "Who voices Durin in Genshin Impact?",
    a: "Laurie Kynaston in English, Tao Dian in Chinese, Chiaki Kobayashi in Japanese, and Kim Ji-yul in Korean.",
  },
  {
    q: "What is Durin's birthday?",
    a: "March 14.",
  },
  {
    q: "Is Durin F2P friendly?",
    a: "Yes — at C0 with Wolf-Fang, Lion's Roar, or Amenoma Kageuchi both forms are fully functional. Signature weapon and constellations are optional.",
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  faqs={faqs}
  heroImage="/official/durin-wish.webp"
>
  <main>
    <Hero />
    <div class="mx-auto max-w-7xl">
      <PageTOC />
      <div class="xl:pr-72">
        <QuickSummary />
        <PullDecider />
        <PrimogemCalculator />
        <Build />
        <Compare />
        <ProsCons />
        <Lore />
        <Materials />
        <FAQ faqs={faqs} />
        <Author />
      </div>
    </div>
  </main>
</Layout>
